# WhereBus 配置示例：复制为 .env 后按需修改
# 真实环境变量优先于本文件，可用 `VAR=... cargo run` 临时覆盖

# ── 服务 ──────────────────────────────────────────────
# 监听地址（网页版 / 管理控制台 / Mini App 共用）
WHEREBUS_BIND=127.0.0.1:8080
# SQLite 数据库路径
WHEREBUS_DB=wherebus.db

# ── Telegram 机器人 ───────────────────────────────────
# 向 @BotFather 申请的机器人令牌；留空或删掉本行就不启动机器人
TELEGRAM_BOT_TOKEN=
# 「我的面板」的公网 HTTPS 地址；Telegram 只允许 HTTPS 的 Mini App
# WHEREBUS_BOT_MINIAPP_URL=https://你的域名/miniapp
# 统计习惯、显示时间所用的时区偏移（小时）
WHEREBUS_BOT_TZ=8
# 自建 Bot API 服务地址；本地联调指向假服务时也用它
# WHEREBUS_BOT_API=https://api.telegram.org

# ── 迁移 ──────────────────────────────────────────────
# 旧版本的 JSON 数据文件；库里还没有用户时自动导入一次，原文件保留
# WHEREBUS_BOT_DATA=wherebus-bot-data.json
